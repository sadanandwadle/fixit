# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/fixit
# Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fixit

# Authentication Security
# Generate secure string via: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=30d

# CORS Allowed Origin (Client URL)
# Single origin or comma-separated list of origins
CLIENT_URL=http://localhost:5173
