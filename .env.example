# ==============================================================
# FIXIT — Local Service Booking Platform
# Environment Variables Example Template (Safe placeholders only)
# ==============================================================

# Backend (server/.env)
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fixit
# Secure random 256-bit JWT secret key (generate via: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=30d
# Allowed frontend client origin(s) for CORS (comma-separated for multiple domains)
CLIENT_URL=https://your-fixit-app.vercel.app

# Frontend (client/.env)
# Production backend API base URL (e.g. deployed Render URL with /api path)
VITE_API_BASE_URL=https://your-fixit-api.onrender.com/api
VITE_APP_NAME=FIXIT
